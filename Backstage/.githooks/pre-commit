#!/bin/sh
# 規範檢查的最後一道關卡 —— 不依賴開發伺服器,也不依賴編輯器擴充。
#
#   1. 色票檔排序不對 → 自動排序並重新 git add(無害的純順序調整)
#   2. 本次 staged 的檔案 → 跑規範檢查(css / api / store / page 四類都在內),印提醒
#   3. 這次動到規則檔的話 → 跑規則自己的驗證,沒過就**擋下 commit**
#
# **規範違規只提醒,規則自己壞掉才擋。** 差別在於「擋下來之後做得到嗎」:
#   既有的違規存量清不完,擋下來只會逼人加 --no-verify,反而讓守門形同虛設;
#   規則壞掉是一兩行的事,當場修得完,而且放過去的代價大得多(見第 3 段)。
#
# 此 hook 由 .githooks/ 進版控,經 core.hooksPath 生效(npm run hooks:install,
# postinstall 會自動跑)。
#
# **一個 repo 可能裝了不只一個專案。** git hook 一律在 repo 根執行,
# 而規範工具在各專案自己的目錄底下 —— 直接跑 node .tools/lint/... 會找不到檔案,
# 整支 hook 掛掉(而且看起來像是工具壞了)。所以下面依 staged 路徑
# 逐一往上找出各自的專案根,再進到那裡執行。

RED='\033[31m'
YELLOW='\033[33m'
GREEN='\033[32m'
RESET='\033[0m'

# 副檔名要與 .tools/lint/project-config.mjs 的 SCANNABLE_EXTENSIONS 一致。
#    shell 沒辦法 import 那份設定,只能人工同步 —— 那邊改了這裡要跟著改。
#    少列一種,那種檔案 commit 時就完全不會被檢查,而且不會有任何徵兆:
#    api、store、actions 都是 .js,漏掉等於整區沒有守門。
STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(vue|css|m?js|cjs|md)$')
[ -z "$STAGED" ] && exit 0

# 這個檔案屬於哪一個專案 —— 從它所在的資料夾往上找,
# 第一個裝了規範工具的目錄就是它的專案根。找不到就回空字串(那個檔案跳過)。
project_root_of() {
  dir=$(dirname "$1")

  while [ -n "$dir" ] && [ "$dir" != "." ] && [ "$dir" != "/" ]; do
    if [ -f "$dir/.tools/lint/lint.mjs" ]; then
      printf '%s\n' "$dir"
      return
    fi
    dir=$(dirname "$dir")
  done

  # repo 根自己就是專案根的情況(一個 repo 一個專案)
  [ -f ".tools/lint/lint.mjs" ] && printf '%s\n' "."
}

# 專案根底下的相對路徑 —— 工具要的是相對它自己的路徑
relative_to() {
  if [ "$2" = "." ]; then
    printf '%s\n' "$1"
  else
    printf '%s\n' "${1#"$2"/}"
  fi
}

ROOTS=$(for f in $STAGED; do project_root_of "$f"; done | sort -u)
[ -z "$ROOTS" ] && exit 0

for root in $ROOTS; do
  FILES=$(for f in $STAGED; do
    [ "$(project_root_of "$f")" = "$root" ] && relative_to "$f" "$root"
  done)

  [ -z "$FILES" ] && continue

  # --- 1. 自動修正(色票排序、空的樣式區塊)----------------------------------
  #
  # 哪些檔案該修由 guard-file.mjs 自己判斷,這裡不重複寫一份判斷 ——
  # 兩邊各判斷一次的話,規則改了只改一邊,行為就開始不一致。

  for rel in $FILES; do
    abs="$root/$rel"
    [ "$root" = "." ] && abs="$rel"
    [ -f "$abs" ] || continue

    BEFORE=$(git hash-object "$abs")
    (cd "$root" && node .tools/lint/guard-file.mjs --write "$rel" >/dev/null 2>&1)
    AFTER=$(git hash-object "$abs")

    if [ "$BEFORE" != "$AFTER" ]; then
      git add "$abs"
      printf "${GREEN}已自動修正格式並加入本次 commit:%s${RESET}\n" "$abs"
    fi
  done

  # --- 2. 規範檢查(只看 staged 的檔案)--------------------------------------

  # shellcheck disable=SC2086
  if ! (cd "$root" && node .tools/lint/lint.mjs $FILES); then
    printf "\n${YELLOW}以上是本次 commit 檔案的規範提醒,commit 照常完成。${RESET}\n"
    printf "${YELLOW}  需要協助時,在 Claude Code 對話框輸入「修正」或「好」,Claude Code 會接手處理${RESET}\n"
    printf "${YELLOW}     (它已經知道是哪個檔案、哪幾行)。${RESET}\n"
    printf "${YELLOW}     此訊息僅為提醒,不會影響 commit;為了讓寫法保持一致,建議找時間調整。${RESET}\n\n"
  fi

  # --- 3. 規則自己有沒有壞掉(這次動到規則檔才跑)-----------------------------
  #
  # 規則改壞了、或改完忘了重新封存指紋,commit 當下不擋的話完全沒有徵兆 ——
  # 那份對不上的指紋一路複製到別的專案,那邊會整批報「規則被改過」,
  # 而他們一個字都沒動。
  #
  # 只在這次有動到規則檔時跑(大約兩秒),一般的 commit 不會被拖慢。

  if echo "$FILES" | grep -qE '^\.tools/lint/.*\.mjs$'; then
    if ! (cd "$root" && npm run test:css --silent); then
      printf "\n${RED}規則自己的驗證沒有通過,這次 commit 停下來。${RESET}\n"
      printf "${RED}  這一項與規範違規不同 —— 上面那些只是提醒,這一個會擋。${RESET}\n"
      printf "${RED}  規則壞掉而放過去的話,那份對不上的指紋會一路複製到別的專案,${RESET}\n"
      printf "${RED}  那邊會整批報「規則被改過」,而他們一個字都沒動。${RESET}\n"
      printf "${RED}  本機覆核:cd %s 之後跑 npm run test:css${RESET}\n\n" "$root"
      exit 1
    fi
  fi
done

exit 0
