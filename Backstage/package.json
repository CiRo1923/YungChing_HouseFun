    "@xmldom/xmldom": "^0.9.12",
    "eslint": "^10.9.1",
    "postcss": "^8.5.26",
    "postcss-calc": "^11.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.3",
    "svgo": "^4.1.0",
    "tailwindcss": "^3.4.19",
    "vite-plugin-image-optimizer": "^2.0.3"
  },
