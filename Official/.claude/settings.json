{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/move-permissions-to-local.cjs 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "把 permissions 搬回 settings.local.json…"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/css-guard-prompt.cjs 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "檢查存檔後的 CSS 規範…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/enforce-conventions.cjs 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/css-guard.js 2>/dev/null || true",
            "statusMessage": "檢查 CSS 規範…"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/sync-conventions.cjs 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/move-permissions-to-local.cjs 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "把 permissions 搬回 settings.local.json…",
            "async": true
          }
        ]
      }
    ]
  }
}
